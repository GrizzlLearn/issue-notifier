<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- Active Objects — хранилище настроек плагина -->
    <ao key="ao-module" name="Issue Notifier Active Objects">
        <description>Хранилище настроек плагина</description>
        <entity>ru.my.ao.UserNotificationSettingsEntity</entity>
        <entity>ru.my.ao.NotificationDelegationEntity</entity>
        <entity>ru.my.ao.AdminSettingsEntity</entity>
    </ao>

    <!-- REST API плагина -->
    <rest key="issue-notifier-rest" name="Issue Notifier REST API" path="/issue-notifier" version="1">
        <description>REST API для управления настройками уведомлений</description>
    </rest>

    <!-- Кнопка в шапке Jira — открывает пользовательские настройки -->
    <web-item key="issue-notifier-nav-item" name="Issue Notifier Settings" section="system.top.navigation.bar" weight="200">
        <label>Уведомления</label>
        <link linkId="issue-notifier-nav-link">/</link>
    </web-item>

    <!-- Пункт в Manage Apps -->
    <web-section key="issue-notifier-admin-section" name="Issue Notifier" location="admin_plugins_menu" weight="100">
        <label>Issue Notifier</label>
    </web-section>
    <web-item key="issue-notifier-admin-link" name="Issue Notifier Admin" section="admin_plugins_menu/issue-notifier-admin-section" weight="10">
        <label>Настройки плагина</label>
        <link>/plugins/servlet/issue-notifier/admin</link>
    </web-item>

    <!-- Сервлет admin-страницы -->
    <servlet key="issue-notifier-admin-servlet" class="ru.my.servlet.AdminSettingsServlet">
        <url-pattern>/issue-notifier/admin</url-pattern>
    </servlet>

    <!-- Загрузчик пункта в шапке: единственное, что грузится на каждой странице.
         Сам диалог подтягивается по клику через WRM.require — иначе React разбирался бы
         при открытии любой задачи, доски и дашборда. -->
    <web-resource key="user-nav-resources" name="Issue Notifier Nav">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <resource type="download" name="user-nav.js" location="/js/user-nav.min.js"/>
        <context>atl.general</context>
    </web-resource>

    <!-- JS-бандл пользовательского диалога: без context, грузится только по требованию -->
    <web-resource key="user-settings-resources" name="Issue Notifier User Settings">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <!-- jira/ajs/select/multi-select — тот же виджет, что рендерит User Picker/Fix Versions
             в самой Jira; используем его для пикеров проектов и делегатов в модалке -->
        <dependency>jira.webresources:frother-multiselect</dependency>
        <resource type="download" name="user-settings.js" location="/js/user-settings.min.js"/>
    </web-resource>

    <!-- JS-бандл для admin-страницы (подключается сервлетом напрямую) -->
    <web-resource key="admin-settings-resources" name="Issue Notifier Admin Settings">
        <resource type="download" name="admin-settings.js" location="/js/admin-settings.min.js"/>
        <resource type="download" name="admin-settings.css" location="/css/admin-settings.css"/>
    </web-resource>

    <!-- Общие ресурсы (CSS) -->
    <web-resource key="issue-notifier-resources" name="Issue Notifier Common Resources">
        <resource type="download" name="issue-notifier.css" location="/css/issue-notifier.css"/>
        <resource type="download" name="images/" location="/images"/>
        <context>atl.general</context>
    </web-resource>
    
</atlassian-plugin>